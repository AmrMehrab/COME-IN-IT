%% COME IN IT — Canonical V1.0 ERD after Architecture Reconciliation
%% Canonical rule: Person -> KYC -> Verified Identity -> Entity -> KYB -> Membership -> Role -> Permission -> Offering -> Verification -> Matching -> Trade -> Audit
%% Healthcare boundary (D-008): Clinical and consent records are intentionally modelled in COME_IN_IT_HEALTH_ERD.mmd.
%% Its sole cross-domain reference is PERSON; it introduces no foreign keys to BUSINESS_ENTITY, offering, matching, contract, order, transaction, dispute, or trade audit entities.
%% Operational foundation (implemented): individual_activity_profiles and business_activity_verifications govern a verified source before trade_offerings, trade_demands and trade_matches realise Offering → Demand → Match across B2B/B2C/C2B/C2C. The relationship evaluator records allow, deny, or manual_review; B2G remains out of the operational scope. See COME_IN_IT_TRADE_OPERATIONS_FOUNDATION.md and COME_IN_IT_COMMERCIAL_CAPABILITIES_RECONCILIATION.md.
erDiagram
    PERSON ||--|| USER_ACCOUNT : owns
    PERSON ||--o{ KYC_RECORD : submits
    KYC_RECORD ||--o| VERIFIED_IDENTITY : produces
    PERSON ||--o{ BUSINESS_MEMBERSHIP : holds
    BUSINESS_ENTITY ||--o{ BUSINESS_MEMBERSHIP : authorizes
    BUSINESS_ENTITY ||--o{ KYB_RECORD : undergoes
    PERSON ||--o{ INDIVIDUAL_ACTIVITY_PROFILE : declares
    BUSINESS_ENTITY ||--o{ BUSINESS_ACTIVITY_VERIFICATION : proves
    BUSINESS_ENTITY ||--o{ TRADE_OFFERING : supplies
    INDIVIDUAL_ACTIVITY_PROFILE ||--o{ TRADE_OFFERING : supplies
    BUSINESS_ENTITY ||--o{ TRADE_DEMAND : requests
    INDIVIDUAL_ACTIVITY_PROFILE ||--o{ TRADE_DEMAND : requests
    TRADE_DEMAND ||--o{ TRADE_MATCH : evaluates
    TRADE_OFFERING ||--o{ TRADE_MATCH : evaluates
    GOVERNMENT_ENTITY ||--o{ GOVERNMENT_PROCUREMENT : issues
    BUSINESS_MEMBERSHIP }o--|| ROLE : receives
    ROLE ||--o{ ROLE_PERMISSION : grants
    PERMISSION ||--o{ ROLE_PERMISSION : included_in

