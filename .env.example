# Local development / integration tests
# MySQL 8 default for the Docker/CI test database
DATABASE_URL=mysql://root:root@127.0.0.1:3306/come_in_it_test

# Application authentication/runtime settings
JWT_SECRET=replace-with-a-local-development-secret
OWNER_OPEN_ID=local-owner
VITE_ANALYTICS_ENDPOINT=

# Didit KYC sandbox configuration (server-side only; never commit real values)
DIDIT_MODE=sandbox
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
