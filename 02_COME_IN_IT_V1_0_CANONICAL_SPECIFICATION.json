    "RESTRICTED": {"storage": "Egypt-first controlled data layer", "access": "relationship and attribute constrained", "encryption": "managed keys and field-level controls"},
    "CONFIDENTIAL": {"storage": "sovereign layer in Egypt", "access": "privileged compliance path", "encryption": "segregated keys and audited access"},
    "SOVEREIGN_REGULATED": {"storage": "Egypt-hosted sovereign layer", "access": "least privilege and government/regulatory scope", "encryption": "sovereign key custody"}
  },
  "entities": [
    {"id":"PERSON","layer":"Identity","purpose":"فرد قانوني أو طبيعي تبدأ منه الهوية","status":"ACTIVE","fields":["id:uuid PK","full_name:verified string","country_code:string","created_at:timestamptz"],"audit":"create/update/read sensitive fields"},
