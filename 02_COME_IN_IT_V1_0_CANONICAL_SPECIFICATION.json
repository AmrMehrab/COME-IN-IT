  "apiBaseline": [
    {"method":"POST","endpoint":"/v1/kyc/records","actor":"INDIVIDUAL","auth":"session","permission":"kyc.submit","audit":"KYC_SUBMITTED"},
    {"method":"POST","endpoint":"/v1/kyc/{id}/verify","actor":"COMPLIANCE","auth":"privileged session","permission":"kyc.verify","audit":"KYC_VERIFIED"},
    {"method":"POST","endpoint":"/v1/entities/{id}/kyb","actor":"BUSINESS_ADMIN","auth":"verified KYC","permission":"kyb.submit","audit":"KYB_SUBMITTED"},
    {"method":"POST","endpoint":"/v1/memberships","actor":"BUSINESS_ADMIN","auth":"verified KYC+KYB","permission":"membership.assign","audit":"MEMBERSHIP_CREATED"},
    {"method":"POST","endpoint":"/v1/offerings","actor":"AUTHORIZED_MEMBER","auth":"verified identity","permission":"offering.create","audit":"OFFERING_REGISTERED"},
    {"method":"POST","endpoint":"/v1/offerings/{id}/verify","actor":"COMPLIANCE","auth":"privileged session","permission":"offering.verify","audit":"OFFERING_VERIFIED"},
    {"method":"POST","endpoint":"/v1/demands","actor":"AUTHORIZED_ACTOR","auth":"verified identity","permission":"demand.create","audit":"DEMAND_CREATED"},
    {"method":"POST","endpoint":"/v1/matches/evaluate","actor":"AUTHORIZED_ACTOR","auth":"verified identity","permission":"matching.evaluate","audit":"MATCH_EVALUATED"},
