    {"method":"POST","endpoint":"/v1/trade/transactions/{id}/disputes","actor":"TRADE_PARTY","auth":"transaction participant","permission":"dispute.open","audit":"TRANSACTION_DISPUTE_OPENED"},
    {"method":"POST","endpoint":"/v1/contracts","actor":"TRADE_PARTY","auth":"active relationship","permission":"contract.create","audit":"CONTRACT_CREATED"},
    {"method":"POST","endpoint":"/v1/orders","actor":"TRADE_PARTY","auth":"active contract","permission":"order.create","audit":"ORDER_CREATED"},
    {"method":"POST","endpoint":"/v1/disputes","actor":"TRADE_PARTY","auth":"contract or transaction scope","permission":"dispute.open","audit":"DISPUTE_OPENED"},
