    {"id":"ORDER","layer":"Trade","purpose":"أمر تنفيذ مشتق من عقد أو عرض","status":"DRAFT|PLACED|CONFIRMED|IN_FULFILLMENT|COMPLETED|CANCELLED","fields":["id:uuid PK","contract_id:uuid FK","buyer_id:uuid FK","seller_id:uuid FK"],"audit":"order lifecycle"},
    {"id":"TRANSACTION","layer":"Trade","purpose":"سجل المعاملة التشغيلي بعد قبول الاقتباس","status":"ACCEPTED|PROCESSING|READY_FOR_PICKUP|IN_TRANSIT|DELIVERED|RECEIVED|CLOSED|CANCELLED|DISPUTED","fields":["id:int PK","rfq_id:int FK","quotation_id:int FK","match_id:int FK","offering_id:int FK","demand_id:int FK","buyer_business_id:int FK nullable","seller_business_id:int FK nullable","buyer_individual_profile_id:int FK nullable","seller_individual_profile_id:int FK nullable","quantity:int","unit_price_minor:int","total_price_minor:int","currency_code:char(3)","payment_status:enum","owner_business_id:int FK nullable","custodian_business_id:int FK nullable","accepted_at:timestamp","closed_at:timestamp nullable"],"audit":"acceptance, payment state, custody, delivery, receipt, closure"},
    {"id":"TRADE_RFQ","layer":"Trade Execution","purpose":"طلب تسعير مضبوط مشتق من Match مؤهل","status":"DRAFT|OPEN|QUOTED|ACCEPTED|EXPIRED|CANCELLED","fields":["id:int PK","match_id:int FK","created_by_user_id:int FK","requested_quantity:int","delivery_terms:json","payment_terms:json","valid_until:timestamp nullable"],"audit":"open/quote/accept/cancel"},
    {"id":"TRADE_QUOTATION","layer":"Trade Execution","purpose":"عرض مورد على RFQ؛ قبول واحد ينشئ Transaction","status":"SUBMITTED|COUNTERED|ACCEPTED|REJECTED|EXPIRED","fields":["id:int PK","rfq_id:int FK","supplier_user_id:int FK","quantity:int","unit_price_minor:int","currency_code:char(3)","lead_time_days:int","terms:json","valid_until:timestamp nullable"],"audit":"submit/counter/accept/reject"},
