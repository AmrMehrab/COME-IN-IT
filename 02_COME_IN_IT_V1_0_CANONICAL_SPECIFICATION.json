    {"id":"PRODUCT_VERIFICATION","layer":"Verification","purpose":"تحقق مستقل من المنتج","status":"DRAFT|SUBMITTED|UNDER_REVIEW|VERIFIED|REJECTED|SUSPENDED|REVOKED|EXPIRED","fields":["id:uuid PK","product_id:uuid FK","evidence_hash:string","reviewer_id:uuid FK","verified_at:timestamptz"],"audit":"all transitions"},
    {"id":"SERVICE","layer":"Offering","purpose":"خدمة أو قدرة تشغيلية قابلة للتجارة","status":"DRAFT|SUBMITTED|UNDER_REVIEW|VERIFIED|REJECTED|SUSPENDED|REVOKED|ARCHIVED","fields":["id:uuid PK","owner_entity_id:uuid FK","service_type:string","coverage_area:jsonb","sla:jsonb"],"audit":"registration and publication"},
    {"id":"SERVICE_VERIFICATION","layer":"Verification","purpose":"تحقق مستقل من الخدمة ومقدمها","status":"DRAFT|SUBMITTED|UNDER_REVIEW|VERIFIED|REJECTED|SUSPENDED|REVOKED|EXPIRED","fields":["id:uuid PK","service_id:uuid FK","evidence_hash:string","reviewer_id:uuid FK"],"audit":"all transitions"},
    {"id":"USED_ASSET","layer":"Offering","purpose":"أصل مستخدم قابل للعرض في C2C أو B2B","status":"DRAFT|SUBMITTED|UNDER_REVIEW|VERIFIED|REJECTED|SUSPENDED|TRANSFERRED|ARCHIVED","fields":["id:uuid PK","owner_person_id:uuid FK","owner_entity_id:uuid FK nullable","asset_type:string","condition_grade:string"],"audit":"ownership and listing changes"},
    {"id":"ASSET_VERIFICATION","layer":"Verification","purpose":"تحقق من الملكية والحالة للأصل المستخدم","status":"DRAFT|SUBMITTED|UNDER_REVIEW|VERIFIED|REJECTED|SUSPENDED|REVOKED|EXPIRED","fields":["id:uuid PK","asset_id:uuid FK","evidence_hash:string","verified_at:timestamptz"],"audit":"all transitions"},
    {"id":"DEMAND","layer":"Trade","purpose":"طلب احتياج لمنتج أو خدمة أو أصل","status":"DRAFT|PUBLISHED|MATCHING|OFFERED|FULFILLED|CANCELLED|EXPIRED","fields":["id:uuid PK","requester_id:uuid FK","demand_type:enum","geography:jsonb","requirements:jsonb"],"audit":"create/publish/close"},
    {"id":"TRADE_RELATIONSHIP","layer":"Trade","purpose":"علاقة تجارية ونطاق وصول بين طرفين","status":"PROPOSED|ACTIVE|SUSPENDED|CLOSED","fields":["id:uuid PK","party_a_id:uuid FK","party_b_id:uuid FK","business_model:enum","access_scope:jsonb"],"audit":"relationship lifecycle"},
