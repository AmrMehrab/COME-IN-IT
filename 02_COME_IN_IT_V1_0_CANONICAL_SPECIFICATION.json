    {"id":"TRANSACTION_DELIVERY","layer":"Fulfillment","purpose":"إثبات التسليم والاستلام والكميات المقبولة","status":"PENDING|ACCEPTED_FULL|ACCEPTED_PARTIAL|REJECTED|DAMAGED|SHORTAGE","fields":["id:int PK","transaction_id:int FK","transport_job_id:int FK","delivered_quantity:int","received_by_user_id:int FK nullable","proof_reference:string nullable","delivered_at:timestamp nullable","received_at:timestamp nullable"],"audit":"delivery/receipt evidence"},
    {"id":"TRANSACTION_EVIDENCE","layer":"Compliance","purpose":"دليل تشغيلي مرتبط بالمعاملة","status":"SEALED","fields":["id:int PK","transaction_id:int FK","created_by_user_id:int FK","evidence_type:enum","reference:string","metadata:json nullable"],"audit":"append-only evidence reference"},
