    {"id":"AUDIT_LOG","layer":"Audit","purpose":"سجل WORM غير قابل للتعديل","status":"SEALED","fields":["id:uuid PK","actor_id:uuid FK","event_type:string","immutable_hash:string","created_at:timestamptz"],"audit":"self-auditing append-only"},
